{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "outDir": "dist-server",
    "resolveJsonModule": true,
    "noEmit": false,
    "allowSyntheticDefaultImports": true
  },
  "include": ["server/**/*.ts"]
}
